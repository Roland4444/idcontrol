# Windows + VS Code (PostgreSQL may run inside WSL2).
# Password in a URL must be URL-encoded when it contains special characters.
DATABASE_URL=postgresql://idcontrol:CHANGE_DB_PASSWORD@127.0.0.1:5432/idcontrol

# Axum binds to localhost; expose it on an internal network via Nginx HTTPS.
LISTEN=127.0.0.1:8090
APP_USER=admin
APP_PASSWORD=CHANGE_ME

# DSM HTTPS / Synology File Station API (NOT SMB/WebDAV)
SYNOLOGY_URL=https://nas.example.local:5001
SYNOLOGY_USERNAME=id_reader
SYNOLOGY_PASSWORD=CHANGE_NAS_PASSWORD
# File Station paths begin with the shared folder name, not /volume1/.
# Affects ONLY this subfolder. Example: /resdata/Исполнительная документация
SYNOLOGY_ROOT="/ResData/ИТ/test/тест (esinitsin)"
# If SYNOLOGY_ROOT directly contains ПД/ and ИД/, these values define
# the project/package created locally in PostgreSQL.
SYNOLOGY_PROJECT_NAME="тест (esinitsin)"
SYNOLOGY_DEFAULT_WORK="Вид работ не указан"
SYNOLOGY_VERIFY_TLS=true
# Optional: a PEM certificate of your own CA for a NAS with private PKI
# SYNOLOGY_CA_CERT=./certificates/synology-ca.pem

# Windows: folders next to Cargo.toml / .env; paths are relative to .env folder.
# DATA_ROOT stores archived copies used by PostgreSQL. DO NOT switch an old
# nonempty DATA_ROOT without migrating its files AND documents.archive_path.
# Original NAS files are read-only: the application never writes to Synology.
DATA_ROOT=./storage
# Temporary Synology downloads and report conversion are kept inside project.
TEMP_ROOT=./storage/temp
POLL_INTERVAL=45
STABLE_SECONDS=15
MAX_FILE_MB=100
OCR_MAX_PAGES=500
# Maximum local ONNX OCR workers across overlapping documents (1..16).
# For a 6-core CPU try 3 first; benchmark 6 for maximum throughput.
OCR_PAGE_WORKERS=6
# NEW in v0.6.7: local = offline neural OCR, NO document sent to external API.
# local_then_vibecode = opt-in fallback when local OCR fails/returns no text.
# vibecode = old API-only mode.
OCR_MODE=local
# Download models using scripts/install-local-ocr-models.ps1 or .sh
LOCAL_OCR_MODEL_DIR=./models/ocr

# VibeCode vision OCR: explicitly enable sending document images to this external service.
# Endpoint from your working example; can be changed to another documented VibeCode endpoint.
VIBE_OCR_ENABLED=false
VIBE_OCR_URL=https://vibecode.bitrix24.tech/v1/ai/chat/completions
# Choose ONE of these options. Keep key in .env or a separate local KEY file.
# VIBE_OCR_KEY=REPLACE_WITH_YOUR_VIBECODE_KEY
# VIBE_OCR_KEY_FILE=KEY
VIBE_OCR_MODEL=
# 0 means omit max_tokens just like the working Rust example
VIBE_OCR_MAX_TOKENS=0
VIBE_OCR_TIMEOUT_SECONDS=120

# HYBRID AI. off = only local rules; VibeCode OCR is independently controlled above.
# gigachat = official GigaChat API; cowork_gateway = our optional enterprise adapter.
AI_MODE=off
# For GigaChat, obtain an API authorization key in the Sber developer account.
# GIGACHAT_AUTH_KEY=BASE64_CLIENT_ID_COLON_CLIENT_SECRET
GIGACHAT_SCOPE=GIGACHAT_API_B2B
GIGACHAT_MODEL=GigaChat-2-Pro
# For GigaCowork, do NOT use an invented URL. This URL MUST point to your
# independently deployed, approved adapter implementing docs/COWORK_GATEWAY_CONTRACT.md.
# AI_GATEWAY_URL=https://ai-gateway.company.local/v1/document-review
# AI_GATEWAY_TOKEN=CHANGE_GATEWAY_TOKEN
# AI_CA_CERT=./certificates/ai-ca.pem
# Bound exposure to small excerpts, never full document by default.
AI_MAX_DOCS=6
AI_MAX_CHARS_PER_DOC=4000

# AI DOCUMENT CLASSIFICATION (independent of OCR and AI normative review):
# Select VibeCode or GigaCowork adapter for each package in the web interface.
# Uses VIBE_OCR_KEY (even when VIBE_OCR_ENABLED=false); never includes keys in UI.
CLASSIFY_VIBE_MODEL=
CLASSIFY_TIMEOUT_SECONDS=120
CLASSIFY_MAX_CHARS=8000
# GigaCowork has no verified public REST endpoint: this MUST be your adapter.
# CLASSIFY_COWORK_URL=https://ai-adapter.example.local/classify
# CLASSIFY_COWORK_TOKEN=YOUR_PRIVATE_GATEWAY_TOKEN

# Bitrix24 local/server-side application (no manually managed access tokens).
# Only BITRIX_DOMAIN is required. Client receives temporary credentials via
# BX24 SDK and Rust independently verifies user.current against THIS hostname.
BITRIX_DOMAIN=yourcompany.bitrix24.ru
# OPTIONAL compatibility with v0.9.1 pre-existing employee ACL assignments.
# Leave unset for new installations; the server derives a stable project scope
# from BITRIX_DOMAIN. Do not guess this value or copy employee ID here.
# BITRIX_MEMBER_ID=previously_configured_member_id
# URL for installing a Bitrix24 local app: https://idai.kenreskenres7772023777.netcraze.link/bitrix
# Debug Basic login is ONLY available when started with: cargo run -- --debug-login
# login admin / password super123; --debug-login honors the configured LISTEN.
# Real Bitrix24 iframe sessions use a Secure/Partitioned cookie over HTTPS.
# To import documents from Synology into one of the fixed 6 projects,
# set SYNOLOGY_PROJECT_NAME to the EXACT project name, e.g. TETRIS.
